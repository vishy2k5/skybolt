# Copy to .env and edit. Never commit .env (it is in .gitignore).
# Every setting is optional; the values below are the defaults.

# --- Server -----------------------------------------------------------------
SKYBOLT_DB_PATH=data/skybolt.db
# The API has no login yet. Keep this on 127.0.0.1 unless you trust your whole network.
SKYBOLT_HOST=127.0.0.1
SKYBOLT_PORT=8000

# --- Weather (Open-Meteo, no account or API key) ------------------------------
# Find your coordinates on any map. Units: imperial | metric
SKYBOLT_LAT=40.7128
SKYBOLT_LON=-74.0060
SKYBOLT_LOCATION_NAME=Home
SKYBOLT_UNITS=imperial

# --- Google Calendar ------------------------------------------------------------
# Seconds between background syncs; 0 turns it off.
SKYBOLT_GOOGLE_SYNC_SECONDS=120
# IANA time zone, needed for repeating Google events. Detected from the system if left empty.
# SKYBOLT_TIMEZONE=America/Denver
# Key that encrypts the stored Google sign-in. If empty, one is generated into data/secret.key.
# SKYBOLT_SECRET_KEY=
# Optional OAuth client file; normally you paste the client in Settings instead.
# SKYBOLT_GOOGLE_CREDENTIALS=credentials.json

# --- Screensaver photos -------------------------------------------------------
# Pictures to show (JPG, PNG, WebP); defaults to a photos/ folder next to the database.
# SKYBOLT_PHOTOS_DIR=data/photos
# Longest side, in pixels, of the resized copies shown on screen.
# SKYBOLT_PHOTO_MAX=1600
